{
	"folders": [
		{
			"path": "apps/racing-coach-client",
			"name": "Client (Python)"
		},
		{
			"path": "apps/lapevo-client",
			"name": "Client (Rust)"
		},
		{
			"path": "apps/racing-coach-server",
			"name": "Server (FastAPI)"
		},
		{
			"path": "apps/racing-coach-web",
			"name": "Web Dashboard"
		},
		{
			"path": "apps/lapevo-marketing",
			"name": "Marketing"
		},
		{
			"path": "libs/racing-coach-core",
			"name": "Core Library (Py)"
		},
		{
			"path": ".",
			"name": "Workspace Root"
		}
	],
	"settings": {
		"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
		"python.terminal.activateEnvironment": true,
		"[python]": {
			"editor.defaultFormatter": "charliermarsh.ruff"
		},
		"python.analysis.typeCheckingMode": "strict",
		"[rust]": {
			"editor.defaultFormatter": "rust-lang.rust-analyzer"
		},
		"rust-analyzer.check.command": "clippy"
	}
}