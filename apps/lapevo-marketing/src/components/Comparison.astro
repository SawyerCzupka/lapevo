---
const comparisonPoints = [
  {
    feature: "Source-available",
    lapevo: false,
    lapevoNote: "Planned",
    trophi: false,
  },
  {
    feature: "Free to use",
    lapevo: true,
    lapevoNote: "Self-hosted",
    trophi: false,
    trophiNote: "7-day trial",
  },
  {
    feature: "Self-hostable",
    lapevo: true,
    trophi: false,
  },
  {
    feature: "iRacing support",
    lapevo: true,
    trophi: true,
  },
  {
    feature: "Post-session analysis",
    lapevo: true,
    trophi: true,
  },
  {
    feature: "Braking zone analysis",
    lapevo: true,
    trophi: true,
  },
  {
    feature: "Corner-by-corner metrics",
    lapevo: true,
    trophi: true,
  },
  {
    feature: "Real-time voice coaching",
    lapevo: false,
    lapevoNote: "Roadmap",
    trophi: true,
  },
  {
    feature: "Expert lap comparison",
    lapevo: false,
    lapevoNote: "Roadmap",
    trophi: true,
  },
  {
    feature: "Own your data",
    lapevo: true,
    lapevoNote: "Your server",
    trophi: false,
    trophiNote: "Their cloud",
  },
];
---

<section class="py-20 md:py-32 bg-card/30">
  <div class="mx-auto max-w-6xl px-6">
    <!-- Section header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        How LapEvo
        <span class="gradient-text">compares</span>
      </h2>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        See how LapEvo compares to Trophi.ai, a commercial AI coaching platform.
        LapEvo is community-driven and free to self-host—some features are still in development.
      </p>
    </div>

    <!-- Comparison table -->
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b border-border">
            <th
              class="text-left py-4 pr-4 text-sm font-medium text-muted-foreground"
              >Feature</th
            >
            <th class="py-4 px-4 text-center">
              <div class="inline-flex items-center gap-2">
                <div
                  class="flex h-6 w-6 items-center justify-center rounded bg-linear-to-br from-blue-500 to-blue-700 text-xs font-bold text-white"
                >
                  L
                </div>
                <span class="text-sm font-semibold text-foreground">LapEvo</span
                >
              </div>
            </th>
            <th class="py-4 px-4 text-center">
              <span class="text-sm font-medium text-muted-foreground">Trophi.ai</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {
            comparisonPoints.map((point) => (
              <tr class="border-b border-border/50">
                <td class="py-4 pr-4 text-sm text-foreground">
                  {point.feature}
                </td>
                <td class="py-4 px-4 text-center">
                  <div class="inline-flex flex-col items-center gap-1">
                    {point.lapevo ? (
                      <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-green-500/20 text-green-400">
                        <svg
                          class="w-4 h-4"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="3"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M5 13l4 4L19 7"
                          />
                        </svg>
                      </span>
                    ) : point.lapevoNote ? (
                      <span class="inline-flex items-center justify-center px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-400 text-xs font-medium">
                        {point.lapevoNote}
                      </span>
                    ) : (
                      <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-red-500/20 text-red-400">
                        <svg
                          class="w-4 h-4"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="3"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M6 18L18 6M6 6l12 12"
                          />
                        </svg>
                      </span>
                    )}
                    {point.lapevo && point.lapevoNote && (
                      <span class="text-xs text-muted-foreground">{point.lapevoNote}</span>
                    )}
                  </div>
                </td>
                <td class="py-4 px-4 text-center">
                  <div class="inline-flex flex-col items-center gap-1">
                    {point.trophi ? (
                      <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-green-500/20 text-green-400">
                        <svg
                          class="w-4 h-4"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="3"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M5 13l4 4L19 7"
                          />
                        </svg>
                      </span>
                    ) : point.trophiNote ? (
                      <span class="inline-flex items-center justify-center px-2 py-0.5 rounded-full bg-muted text-muted-foreground text-xs font-medium">
                        {point.trophiNote}
                      </span>
                    ) : (
                      <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-red-500/20 text-red-400">
                        <svg
                          class="w-4 h-4"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="3"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M6 18L18 6M6 6l12 12"
                          />
                        </svg>
                      </span>
                    )}
                    {point.trophi && point.trophiNote && (
                      <span class="text-xs text-muted-foreground">{point.trophiNote}</span>
                    )}
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- Bottom CTA -->
    <div class="mt-12 text-center">
      <p class="text-sm text-muted-foreground mb-4">
        Help guide development and get notified when LapEvo launches
      </p>
      <a
        href="#waitlist"
        class="inline-flex rounded-lg bg-linear-to-r from-blue-500 to-blue-600 px-6 py-3 text-sm font-medium text-white transition-all hover:from-blue-600 hover:to-blue-700"
      >
        Help Shape LapEvo
      </a>
    </div>
  </div>
</section>
